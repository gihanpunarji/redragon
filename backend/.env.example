# Environment Configuration
NODE_ENV=production
PORT=5001

# Database Configuration (MySQL)
# Replace with your MySQL database credentials
DB_HOST=your_database_host
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# JWT Configuration
# Generate a strong random secret key (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS Configuration
# Replace with your frontend URL
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration
# Sign up at https://cloudinary.com/ and get your credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# PayHere Payment Gateway
# Sign up at https://www.payhere.lk/ and get your credentials
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_SECRET=your_payhere_secret

# Email Configuration (SMTP)
# Configure your SMTP email service
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=465
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_password

# Koko Payment Gateway (Optional)
# Sign up at https://paykoko.com/ and get your credentials
KOKO_MERCHANT_ID=your_koko_merchant_id
KOKO_API_KEY=your_koko_api_key
KOKO_QA_API_URL=https://qaapi.paykoko.com
KOKO_PROD_API_URL=https://prodapi.paykoko.com
KOKO_PLUGIN_NAME=customapi
KOKO_PLUGIN_VERSION=1.0.1

# Koko RSA Keys
# Generate RSA key pair using: openssl genrsa -out private.pem 1024
# Extract public key: openssl rsa -in private.pem -outform PEM -pubout -out public.pem
KOKO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour_Public_Key_Here\n-----END PUBLIC KEY-----"
KOKO_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour_Private_Key_Here\n-----END RSA PRIVATE KEY-----"
